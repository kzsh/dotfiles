#!/bin/bash
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  SOURCING=1
else
  SOURCING=
fi

_zig_fail() {
  echo "$1" >&2
  [[ -n "$SOURCING" ]] && return 1 || exit 1
}

EXPECTED_VERSION="$(echo "$1" | grep -E '^v?[0-9][0-9a-zA-Z.+-]*$')"

if [[ -z "$EXPECTED_VERSION" ]]; then
  _zig_fail "Usage: source zig <version>  (e.g. 0.15.2 or 0.16.0-dev.1366+4ea472808)"
fi

ZIG_BASE="$HOME/packages/zig"

# Dirs are named zig-x86_64-linux-VERSION or zig-linux-x86_64-VERSION
ZIG_DIR="$(find "$ZIG_BASE" -maxdepth 1 -type d -name "*${EXPECTED_VERSION}" 2>/dev/null | head -1)"

if [[ -z "$ZIG_DIR" ]]; then
  _zig_fail "Zig $EXPECTED_VERSION not found in $ZIG_BASE"
fi

export PATH="$ZIG_DIR:$PATH"
echo "Using zig $EXPECTED_VERSION from $ZIG_DIR"
