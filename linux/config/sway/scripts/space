#!/bin/bash
# Workspace switcher for sway
# Workspaces are named <key>(<set>) where set is a context name (e.g., "main", "work")
#
# Usage:
#   space switch <key>   — switch to workspace <key>(<current_set>)
#   space move <key>     — move container to workspace <key>(<current_set>)
#   space set <name>     — change active set
#   space set-menu       — pick set via wofi
#   space ice [set]      — save layout, move all windows to _
#   space thaw [set]     — restore windows and layout
#   space ice-menu       — pick a set to thaw via wofi

STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sway"
STATE_FILE="$STATE_DIR/current_space_set"
SETS_FILE="$STATE_DIR/space_sets"
ICE_DIR="$STATE_DIR/ice"
KEYS=(Q W E R T A S D F G Z X C V B)

default_sets() {
    echo "main"
    echo "work"
    echo "scratch"
}

current_set() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "main"
    fi
}

list_sets() {
    if [[ -f "$SETS_FILE" ]]; then
        cat "$SETS_FILE"
    else
        default_sets
    fi
}

list_iced() {
    if [[ -d "$ICE_DIR" ]]; then
        ls -1 "$ICE_DIR" 2>/dev/null | sed 's/\.json$//'
    fi
}

case "$1" in
    switch)
        swaymsg workspace "${2}($(current_set))"
        ;;
    move)
        swaymsg move container to workspace "${2}($(current_set))"
        ;;
    set)
        mkdir -p "$STATE_DIR"
        echo "$2" > "$STATE_FILE"
        ;;
    set-menu)
        choice=$(list_sets | wofi --show dmenu --prompt "Space set")
        if [[ -n "$choice" ]]; then
            if ! grep -qxF "$choice" "$SETS_FILE" 2>/dev/null; then
                mkdir -p "$STATE_DIR"
                echo "$choice" >> "$SETS_FILE"
            fi
            exec "$0" set "$choice"
        fi
        ;;
    ice)
        set_name="${2:-$(current_set)}"
        mkdir -p "$ICE_DIR"
        ice_file="$ICE_DIR/${set_name}.json"
        
        # Build workspace names for this set
        workspaces=()
        for key in "${KEYS[@]}"; do
            workspaces+=("${key}(${set_name})")
        done
        
        # Extract workspace layouts and windows in tree order
        tree_json=$(swaymsg -t get_tree)
        
        echo "$tree_json" | jq --argjson ws "$(printf '%s\n' "${workspaces[@]}" | jq -R . | jq -s .)" '
            def windows_in_order:
                if .type == "con" and .pid != null then
                    [{con_id: .id, app_id: .app_id, name: .name, floating: false}]
                elif .nodes then
                    [.nodes[] | windows_in_order] | add // []
                else
                    []
                end;
            
            def floating_windows:
                if .floating_nodes then
                    [.floating_nodes[] | select(.pid != null) | {con_id: .id, app_id: .app_id, name: .name, floating: true}]
                else
                    []
                end;
            
            [
                recurse(.nodes[]?) |
                select(.type == "workspace" and (.name as $n | $ws | index($n))) |
                {
                    workspace: .name,
                    layout: .layout,
                    windows: (windows_in_order + floating_windows)
                }
            ] | map(select(.windows | length > 0))
        ' > "$ice_file"
        
        # Check if we found any windows
        window_count=$(jq '[.[].windows[]] | length' "$ice_file")
        if [[ "$window_count" -eq 0 ]]; then
            rm "$ice_file"
            notify-send "Ice: No windows in set '$set_name'"
            exit 0
        fi
        
        # Move all windows to _
        jq -r '.[].windows[].con_id' "$ice_file" | while read -r con_id; do
            swaymsg "[con_id=$con_id] move to workspace _"
        done
        
        notify-send "Iced: $set_name ($window_count windows)"
        ;;
    thaw)
        set_name="${2:-$(current_set)}"
        ice_file="$ICE_DIR/${set_name}.json"
        
        if [[ ! -f "$ice_file" ]]; then
            notify-send "No iced set: $set_name"
            exit 1
        fi
        
        # Count windows to restore
        window_count=$(jq '[.[].windows[]] | length' "$ice_file")
        restored=0
        
        # Process each workspace
        while read -r ws_data; do
            ws_name=$(echo "$ws_data" | jq -r '.workspace')
            ws_layout=$(echo "$ws_data" | jq -r '.layout')
            
            # Move windows back in order
            while read -r win; do
                con_id=$(echo "$win" | jq -r '.con_id')
                is_floating=$(echo "$win" | jq -r '.floating')
                
                # Check if window still exists
                if swaymsg "[con_id=$con_id] move to workspace \"$ws_name\"" 2>/dev/null; then
                    ((restored++))
                    if [[ "$is_floating" == "true" ]]; then
                        swaymsg "[con_id=$con_id] floating enable" 2>/dev/null
                    fi
                fi
            done < <(echo "$ws_data" | jq -c '.windows[]')
            
            # Set workspace layout
            swaymsg "workspace \"$ws_name\", layout $ws_layout" 2>/dev/null || true
        done < <(jq -c '.[]' "$ice_file")
        
        rm "$ice_file"
        notify-send "Thawed: $set_name ($restored/$window_count windows)"
        ;;
    ice-menu)
        iced=$(list_iced)
        if [[ -z "$iced" ]]; then
            notify-send "No iced sets"
            exit 0
        fi
        choice=$(echo "$iced" | wofi --show dmenu --prompt "Thaw set")
        if [[ -n "$choice" ]]; then
            exec "$0" thaw "$choice"
        fi
        ;;
    current)
        current_set
        ;;
    *)
        echo >&2 "Usage: space {switch|move|set|set-menu|ice|thaw|ice-menu|current} [arg]"
        exit 1
        ;;
esac
