{
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": [],
    "modules-right": [
        "custom/space-set",
        "pulseaudio",
        "custom/vpn",
        "network",
        "cpu",
        "load",
        "temperature",
        "memory",
        "battery",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "custom/space-set": {
        "exec": "cat ~/.config/sway/current_space_set 2>/dev/null || echo A",
        "interval": 1,
        "format": "<sub>{}</sub>"
    },

    "custom/vpn": {
        "exec": "ifconfig | grep -q '^tun' && echo '󰖂' || echo ''",
        "interval": 30
    },

    "pulseaudio": {
        "format": "♫ {volume}%",
        "format-muted": "♫ muted",
        "on-click": "pavucontrol"
    },

    "network": {
        "interval": 30,
        "format-wifi": "{ipaddr} {signalStrength}%",
        "format-ethernet": "{ipaddr}",
        "format-disconnected": "disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n{essid} {frequency}MHz"
    },

    "cpu": {
        "interval": 10,
        "format": "{icon}",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },

    "load": {
        "interval": 10,
        "format": "<sup><span size='8pt'>1</span></sup>{load1} <sup><span size='8pt'>5</span></sup>{load5} <sup><span size='8pt'>15</span></sup>{load15}"
    },

    "temperature": {
        "interval": 20,
        "format": "{temperatureC}°C"
    },

    "memory": {
        "interval": 30,
        "format": "<sup>U</sup>{used:0.0f}G <sup>C</sup>{cached:0.0f}G <sup>S</sup>{swapUsed:0.0f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {power:0.1f}W",
        "format-charging": "{capacity}%↑ {power:0.1f}W",
        "format-plugged": "{capacity}%",
        "format-full": "{capacity}%"
    },

    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d<span foreground='#777'>T</span>%H:%M:%S}"
    }
}
